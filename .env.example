# DemoPeter Web（只读问答）
# Jason Mac 默认 WEB_PORT=5210；若仍用旧端口则改回 5200
GUIBU_DEMOPETER_BASE_URL=http://127.0.0.1:5210

# 可选检索参数
GUIBU_DEMOPETER_TOP_K=5
GUIBU_DEMOPETER_THRESHOLD=0.3

# Guibu → Tatha 信号桥（POST /v1/skills/ingest）
# Tatha ingest 基址或完整 URL（冒烟默认 http://127.0.0.1:8010）
TATHA_SIGNAL_INGEST_URL=http://127.0.0.1:8010
# 与 Tatha 共享 HMAC 密钥：X-Signature = HMAC-SHA256(SIGNAL_BRIDGE_SECRET, raw_body)
# 未配置则 Tatha 走 dev 免签（仅本地冒烟）
SIGNAL_BRIDGE_SECRET=change-me-shared-secret
